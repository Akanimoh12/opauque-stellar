{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opaque.stellar/deployments/manifest.schema.json",
  "title": "Opaque Stellar Deployment Manifest v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "release",
    "network",
    "networkPassphrase",
    "deploymentLedger",
    "contracts",
    "artifacts"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0",
      "description": "Manifest schema version. Bump on structural changes."
    },
    "release": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "network": {
      "type": "string",
      "enum": ["testnet", "mainnet"]
    },
    "networkPassphrase": {
      "type": "string",
      "minLength": 1
    },
    "rpcUrl": {
      "type": "string",
      "format": "uri"
    },
    "horizonUrl": {
      "type": "string",
      "format": "uri"
    },
    "deploymentLedger": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "deployedAt": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "deployer": {
      "type": ["string", "null"],
      "description": "Stellar account (G…) that submitted deploy transactions"
    },
    "admin": {
      "type": ["string", "null"],
      "description": "Contract admin account or role holder"
    },
    "multisig": {
      "type": ["string", "null"],
      "description": "Multisig account controlling upgrades, if any"
    },
    "deploymentStatus": {
      "type": "string",
      "enum": ["template", "deployed", "not_deployed"]
    },
    "wiring": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/wiringBlock" }
      ],
      "description": "Cross-contract wiring recorded after deploy."
    },
    "contracts": {
      "type": "object",
      "required": [
        "stealthRegistry",
        "stealthAnnouncer",
        "groth16Verifier",
        "reputationVerifier",
        "schemaRegistry",
        "attestationEngineV2"
      ],
      "additionalProperties": false,
      "properties": {
        "stealthRegistry": { "$ref": "#/$defs/contractRecord" },
        "stealthAnnouncer": { "$ref": "#/$defs/contractRecord" },
        "groth16Verifier": { "$ref": "#/$defs/contractRecord" },
        "reputationVerifier": { "$ref": "#/$defs/contractRecord" },
        "schemaRegistry": { "$ref": "#/$defs/contractRecord" },
        "attestationEngineV2": { "$ref": "#/$defs/contractRecord" },
        "poolVerifier": { "$ref": "#/$defs/contractRecord" },
        "privacyPool": { "$ref": "#/$defs/contractRecord" },
        "relayerRegistry": { "$ref": "#/$defs/contractRecord" },
        "multisigAdmin": { "$ref": "#/$defs/contractRecord" }
      }
    },
    "artifacts": {
      "type": "object",
      "required": ["frontend", "circuits"],
      "additionalProperties": false,
      "properties": {
        "frontend": {
          "type": "object",
          "required": ["buildCommit"],
          "properties": {
            "buildCommit": { "type": ["string", "null"] },
            "repository": { "type": "string" }
          }
        },
        "scanner": {
          "type": "object",
          "properties": {
            "wasmHash": { "type": ["string", "null"], "pattern": "^(|[a-f0-9]{64})$" }
          }
        },
        "circuits": {
          "type": "object",
          "required": ["v1", "v2"],
          "additionalProperties": false,
          "properties": {
            "v1": { "$ref": "#/$defs/circuitArtifactRecord" },
            "v2": { "$ref": "#/$defs/circuitArtifactRecord" },
            "v3": { "$ref": "#/$defs/circuitArtifactRecord" }
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "required": ["command"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "output": { "type": ["string", "null"] }
      }
    }
  },
  "$defs": {
    "circuitArtifactRecord": {
      "type": "object",
      "required": [
        "witnessWasmHash",
        "zkeyHash",
        "r1csHash",
        "verificationKeyHash",
        "contractVkHash",
        "zkeyHashBinding"
      ],
      "additionalProperties": false,
      "properties": {
        "witnessWasmHash": { "type": ["string", "null"], "pattern": "^(|[a-f0-9]{64})$" },
        "zkeyHash": { "type": ["string", "null"], "pattern": "^(|[a-f0-9]{64})$" },
        "r1csHash": { "type": ["string", "null"], "pattern": "^(|[a-f0-9]{64})$" },
        "verificationKeyHash": { "type": ["string", "null"], "pattern": "^(|[a-f0-9]{64})$" },
        "contractVkHash": { "type": ["string", "null"], "pattern": "^(|[a-f0-9]{64})$" },
        "zkeyHashBinding": { "type": ["string", "null"], "pattern": "^(|[a-f0-9]{64})$" }
      }
    },
    "contractRecord": {
      "type": "object",
      "required": ["id", "wasmHash"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": ["string", "null"],
          "pattern": "^(|C[A-Z2-7]{55})$"
        },
        "wasmHash": {
          "type": ["string", "null"],
          "pattern": "^(|[a-f0-9]{64})$",
          "description": "SHA-256 hex of deployed WASM artifact"
        },
        "package": { "type": "string" }
      }
    },
    "wiringBlock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reputationVerifier": { "$ref": "#/$defs/reputationVerifierWiring" },
        "attestationEngineV2": { "$ref": "#/$defs/attestationEngineWiring" },
        "privacyPool": { "$ref": "#/$defs/privacyPoolWiring" },
        "relayerRegistry": { "$ref": "#/$defs/relayerRegistryWiring" }
      }
    },
    "reputationVerifierWiring": {
      "type": "object",
      "required": ["admin", "groth16Verifier"],
      "additionalProperties": false,
      "properties": {
        "admin": { "type": "string", "pattern": "^G[A-Z2-7]{55}$" },
        "groth16Verifier": { "type": "string", "pattern": "^C[A-Z2-7]{55}$" }
      }
    },
    "attestationEngineWiring": {
      "type": "object",
      "required": ["admin", "schemaRegistry"],
      "additionalProperties": false,
      "properties": {
        "admin": { "type": "string", "pattern": "^G[A-Z2-7]{55}$" },
        "governance": { "type": "string", "pattern": "^G[A-Z2-7]{55}$" },
        "schemaRegistry": { "type": "string", "pattern": "^C[A-Z2-7]{55}$" },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "privacyPoolWiring": {
      "type": "object",
      "required": ["admin", "groth16Verifier", "nativeSac", "scope"],
      "additionalProperties": false,
      "properties": {
        "admin": { "type": "string", "pattern": "^G[A-Z2-7]{55}$" },
        "groth16Verifier": { "type": "string", "pattern": "^C[A-Z2-7]{55}$" },
        "nativeSac": { "type": "string", "pattern": "^C[A-Z2-7]{55}$" },
        "scope": { "type": "integer", "minimum": 0 },
        "depositPresetsXlm": {
          "type": "array",
          "description": "One-tap deposit amount presets (XLM) offered on the deposit screen to keep deposit sizes uniform and preserve the anonymity set.",
          "items": { "type": "number", "exclusiveMinimum": 0 },
          "minItems": 1
        }
      }
    },
    "relayerRegistryWiring": {
      "type": "object",
      "required": ["admin", "nativeSac", "privacyPool", "minimumStake", "unstakeCooldownLedgers", "maxDeadlineLedgers"],
      "additionalProperties": false,
      "properties": {
        "admin": { "type": "string", "pattern": "^G[A-Z2-7]{55}$" },
        "nativeSac": { "type": "string", "pattern": "^C[A-Z2-7]{55}$" },
        "privacyPool": { "type": "string", "pattern": "^C[A-Z2-7]{55}$" },
        "gatewayUrls": {
          "type": "array",
          "items": { "type": "string", "format": "uri" }
        },
        "minimumStake": { "type": "integer", "minimum": 0 },
        "unstakeCooldownLedgers": { "type": "integer", "minimum": 1 },
        "maxDeadlineLedgers": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
